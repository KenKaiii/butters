{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The tray panel may call Butters' own commands and nothing else.",
  "windows": ["panel"],
  "local": true,
  "permissions": [
    "allow-scan",
    "allow-scan-services",
    "allow-cached-services",
    "allow-live-stats",
    "allow-smoothness",
    "allow-fan-culprits",
    "allow-sweep-targets",
    "allow-deep-clean",
    "allow-deep-clean-run",
    "allow-deep-clean-seen",
    "allow-play-sound",
    "allow-notify-permission",
    "allow-fix-notify-permission",
    "allow-close-item",
    "allow-ignore-item",
    "allow-get-settings",
    "allow-set-settings",
    "allow-hide-panel",
    "allow-hold-panel",
    "allow-is-playground",
    "allow-playground-reset",
    "allow-playground-status",
    "allow-quit-butters",
    "allow-update-status",
    "allow-check-update",
    "allow-install-update"
  ]
}
